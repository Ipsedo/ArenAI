<rml>
<head>
    <title>Controls</title>
    <link type="text/rcss" href="menu.rcss"/>
</head>
<body id="controls-body" data-model="controls">
    <div class="topbar">
        <div class="back-arrow" autofocus data-event-click="back()">‹ Back</div>
        <span class="side-player">◆ Player</span>
    </div>

    <div id="controls-panel" class="page">
        <div class="page-head">
            <h1>Controls</h1>
            <span class="page-sub">how you drive your side</span>
        </div>

        <div class="columns">
            <div class="col narrow">
                <div class="param-row">
                    <span class="param-label">Input</span>
                    <div class="toggle stack" data-class-selected="controller=='keyboard'" data-event-click="set_controller('keyboard')">Mouse + Keyboard</div>
                    <div class="toggle stack" data-class-selected="controller=='gamepad'" data-event-click="set_controller('gamepad')">Gamepad</div>
                </div>

                <div class="param-row" data-if="controller=='gamepad'">
                    <span class="param-label">Device</span>
                    <div class="device-list" data-if="selected_gamepad >= 0">
                        <div class="device-entry" data-for="gamepads" data-class-selected="it_index == selected_gamepad" data-event-click="select_pad(it_index)">{{it}}</div>
                    </div>
                    <div class="status-box" data-if="selected_gamepad < 0">No gamepad detected — plug one in, it will show up here.</div>
                </div>

                <div class="callout player" data-class-warn="bind_warning" data-if="bind_status != ''">{{bind_status}}</div>
            </div>

            <div class="col">
                <span class="param-label">Bindings</span>
                <div class="bind-grid" data-if="controller=='keyboard'">
                    <div class="bind-row" data-for="kb_rows">
                        <span class="bind-action">{{it.label}}</span>
                        <div class="keychip" data-class-listening="it.listening" data-class-unbound="!it.bound" data-event-click="capture_kb(it_index)">{{it.binding}}</div>
                    </div>
                    <div class="bind-row fixed">
                        <span class="bind-action">Aim</span>
                        <div class="keychip">MOUSE</div>
                    </div>
                    <div class="bind-row fixed">
                        <span class="bind-action">Pause / Cursor</span>
                        <div class="keychip">ESC</div>
                    </div>
                </div>
                <div class="bind-grid" data-if="controller=='gamepad'">
                    <div class="bind-row" data-for="gp_rows">
                        <span class="bind-action">{{it.label}}</span>
                        <div class="keychip" data-class-listening="it.listening" data-class-unbound="!it.bound" data-event-click="capture_gp(it_index)">{{it.binding}}</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="actions">
            <div class="button" data-event-click="reset_bindings()">Reset to defaults</div>
            <div class="button primary" data-event-click="back()">Back</div>
        </div>
    </div>
</body>
</rml>
