<rml>
<head>
    <title>Game Over</title>
    <link type="text/rcss" href="menu.rcss"/>
</head>
<body class="overlay" data-model="settings">
    <div id="game-over-panel" class="panel">
        <h1>Game Over</h1>
        <div class="game-over-score">Score {{score}}</div>
        <div class="button primary" autofocus data-event-click="game_over_retry()"><div class="fill">Retry</div></div>
        <div class="button" data-event-click="pause_main_menu()">Main menu</div>
        <div class="button" data-event-click="pause_exit()">Exit game</div>
    </div>
</body>
</rml>
