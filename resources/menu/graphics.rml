<rml>
<head>
    <title>Graphics</title>
    <link type="text/rcss" href="menu.rcss"/>
</head>
<body id="graphics-body" data-model="graphics">
    <div class="topbar">
        <div class="back-arrow" autofocus data-event-click="back()">‹ Back</div>
        <span class="crumb">Parameters / Graphics</span>
    </div>

    <div id="graphics-panel" class="page">
        <div class="page-head">
            <h1>Graphics</h1>
            <span class="page-sub">your view and the machine's</span>
        </div>

        <div class="columns">
            <div class="col">
                <div class="param-row">
                    <span class="param-label">Display</span>
                    <div class="toggle-grid" id="display-row">
                        <div class="toggle half" data-class-selected="display=='windowed'" data-event-click="set_display('windowed')">Windowed</div>
                        <div class="toggle half" data-class-selected="display=='fullscreen'" data-event-click="set_display('fullscreen')">Fullscreen</div>
                    </div>
                </div>

                <div class="param-row">
                    <span class="param-label">Shadows</span>
                    <div class="toggle-grid">
                        <div class="toggle fifth" data-class-selected="shadow_quality=='off'" data-event-click="set_shadow_quality('off')">Off</div>
                        <div class="toggle fifth" data-class-selected="shadow_quality=='low'" data-event-click="set_shadow_quality('low')">Low</div>
                        <div class="toggle fifth" data-class-selected="shadow_quality=='medium'" data-event-click="set_shadow_quality('medium')">Medium</div>
                        <div class="toggle fifth" data-class-selected="shadow_quality=='high'" data-event-click="set_shadow_quality('high')">High</div>
                        <div class="toggle fifth" data-class-selected="shadow_quality=='ultra'" data-event-click="set_shadow_quality('ultra')">Ultra</div>
                    </div>
                </div>

                <div class="param-row">
                    <span class="param-label">Anti-aliasing</span>
                    <div class="toggle-grid">
                        <div class="toggle quarter" data-class-selected="msaa == 1" data-event-click="set_msaa(1)">Off</div>
                        <div class="toggle quarter" data-class-selected="msaa == 2" data-event-click="set_msaa(2)">2x</div>
                        <div class="toggle quarter" data-class-selected="msaa == 4" data-event-click="set_msaa(4)">4x</div>
                        <div class="toggle quarter" data-class-selected="msaa == 8" data-event-click="set_msaa(8)">8x</div>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="param-row">
                    <span class="param-label side-player">◆ Window GPU <span class="dim">— your view</span></span>
                    <div class="dropdown" id="window-gpu-dropdown">
                        <div class="dropdown-head player" id="window-gpu-head" data-class-open="window_gpu_open" data-event-click="toggle_window_gpu()">
                            <span class="dropdown-value">{{window_gpu}}</span><span class="dropdown-caret">›</span>
                        </div>
                        <div class="dropdown-list" id="window-gpu-list" data-if="window_gpu_open">
                            <div class="dropdown-item" data-for="gpus" data-class-selected="it_index == selected_window_gpu" data-event-click="set_window_gpu(it_index)">{{it}}</div>
                        </div>
                    </div>
                    <p class="hint">Takes effect on the next startup.</p>
                    <p class="hint warn" data-if="window_gpu_env">Overridden by the ARENAI_VK_DEVICE_WINDOW environment variable.</p>
                </div>

                <div class="param-row">
                    <span class="param-label side-ai">◆ AI vision GPU <span class="dim">— the machine's eyes</span></span>
                    <div class="dropdown" id="vision-gpu-dropdown">
                        <div class="dropdown-head" id="vision-gpu-head" data-class-open="vision_gpu_open" data-event-click="toggle_vision_gpu()">
                            <span class="dropdown-value">{{vision_gpu}}</span><span class="dropdown-caret">›</span>
                        </div>
                        <div class="dropdown-list" id="vision-gpu-list" data-if="vision_gpu_open">
                            <div class="dropdown-item" data-for="gpus" data-class-selected="it_index == selected_vision_gpu" data-event-click="set_vision_gpu(it_index)">{{it}}</div>
                        </div>
                    </div>
                    <p class="hint warn" data-if="vision_gpu_env">Overridden by the ARENAI_VK_DEVICE environment variable.</p>
                </div>
            </div>
        </div>

        <div class="actions">
            <div class="button" data-event-click="back()">Back</div>
        </div>
    </div>
</body>
</rml>
