/* In-game HUD: a transparent full-screen layer that ignores the pointer and
   carries only the aiming reticle. Not linked to menu.rcss on purpose: the
   menu body paints a background and pads the content. */

body {
    width: 100%;
    height: 100%;
    pointer-events: none;
}

/* zero-sized anchor placed by code (left/top in px) at the point where the
   canon axis meets the screen; hidden from code when that point is off
   screen. Its children center themselves on it with negative margins. */
#reticle {
    position: absolute;
    width: 0;
    height: 0;
    left: 50%;
    top: 50%;
    visibility: hidden;
}

/* the crosshair, drawn by the gui-registered reticle decorator inside this
   centered square: arms 2dp thick, stopping 7dp short of the center */
#crosshair {
    position: absolute;
    width: 48dp;
    height: 48dp;
    left: 0;
    top: 0;
    margin-left: -24dp;
    margin-top: -24dp;
    color: #EAF7FFCC;
    decorator: reticle(2dp 7dp);
}

/* the X of the marker is drawn by the gui-registered hit-marker decorator
   inside this centered square: bars 3dp thick, stopping 6dp short of the
   center. Its color paints the bars; its opacity is driven from code (1 on
   a hit, animated down to 0). */
#hit-marker {
    position: absolute;
    width: 36dp;
    height: 36dp;
    left: 0;
    top: 0;
    margin-left: -18dp;
    margin-top: -18dp;
    opacity: 0;
    color: #EAF7FF;
    decorator: hit-marker(3dp 6dp);
}

/* the shell that destroyed the tank flashes red */
#hit-marker.kill {
    color: #FF3B3B;
}
