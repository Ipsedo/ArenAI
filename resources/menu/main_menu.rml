<rml>
<head>
    <title>ArenAI</title>
    <link type="text/rcss" href="menu.rcss"/>
</head>
<body id="main-body" data-model="main">
    <div class="topbar">
        <span class="side-player">◆ Player</span>
        <span class="crumb">ArenAI · season 0</span>
        <span class="side-ai">Neural opponent ◆</span>
    </div>

    <div id="main-panel" class="hero">
        <h1 class="title"><span class="side-player">Aren</span><span class="side-ai">AI</span></h1>
        <p class="tagline"><span class="side-player">You</span><span class="vs">vs</span><span class="side-ai">the machine</span></p>

        <div class="hero-buttons">
            <div class="button primary wide-play" autofocus data-class-disabled="!can_play" data-event-click="play()">Play</div>
            <div class="button wide-play" data-event-click="navigate('parameters')">Parameters</div>
            <div class="button exit" data-event-click="exit()">Exit</div>
        </div>

        <div class="callout ai" data-if="!can_play"><span class="bang">!</span>Select a trained AI model folder in Parameters to play.</div>
    </div>

    <div class="bottombar">
        <span>{{input_summary}}</span>
        <span>{{agent_summary}}</span>
    </div>
</body>
</rml>
