<rml>
<head>
    <title>Parameters</title>
    <link type="text/rcss" href="menu.rcss"/>
</head>
<body data-model="settings">
    <div id="params-panel" class="panel">
        <div class="params-header">
            <div class="back-arrow" data-event-click="back()">←</div>
            <h1>Parameters</h1>
        </div>

        <div class="param-row">
            <span class="param-label">Enemy tanks: {{nb_tanks}}</span>
            <input type="range" autofocus min="1" max="32" step="1" data-value="nb_tanks"/>
        </div>

        <div class="param-row">
            <span class="param-label">Spawn area side: {{spawn_side}} m</span>
            <input type="range" min="100" max="2000" step="50" data-value="spawn_side"/>
        </div>

        <div class="configure-group">
            <div class="button configure" data-event-click="open_graphics()">Configure Graphics</div>
            <div class="button configure" data-event-click="open_controls()">Configure Controls</div>
            <div class="button configure" data-event-click="open_ai()">Configure AI</div>
        </div>
        <p class="hint status-error" data-if="!agent_valid">The AI model is not loaded yet — configure it before playing.</p>

        <div class="row-buttons back-row">
            <div class="button primary" data-event-click="back()"><div class="fill">Back</div></div>
        </div>
    </div>
</body>
</rml>
