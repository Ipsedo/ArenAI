<rml>
<head>
    <title>Paused</title>
    <link type="text/rcss" href="menu.rcss"/>
</head>
<body class="overlay" data-model="pause">
    <div id="pause-panel" class="panel">
        <h1>Paused</h1>
        <div class="game-over-score">Score {{score}}</div>
        <div class="button primary" autofocus data-event-click="popup_continue()">Continue</div>
        <div class="button" data-event-click="popup_main_menu()">Main menu</div>
        <div class="button" data-event-click="popup_exit()">Exit game</div>
    </div>
</body>
</rml>
